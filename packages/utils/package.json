{
  "name": "@viclip/utils",
  "license": "GPL-3.0-or-later",
  "version": "1.0.0",
  "private": true,
  "description": "Shared utility functions for Viclip",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./date": {
      "types": "./src/date.ts",
      "default": "./src/date.ts"
    },
    "./text": {
      "types": "./src/text.ts",
      "default": "./src/text.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@viclip/tsconfig": "workspace:*",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@viclip/constants": "workspace:*",
    "@viclip/types": "workspace:*"
  }
}
