    "@viclip/types": "workspace:*",
    "@viclip/utils": "workspace:*",
    "expo": "~57.0.22",
    "expo-blur": "^57.0.3",
    "expo-build-properties": "~57.0.17",
    "expo-clipboard": "~57.0.2",
