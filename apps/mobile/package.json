{
  "name": "@viclip/mobile",
  "license": "GPL-3.0-or-later",
  "version": "2.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "dotenv -e ../../.env -- expo start",
    "dev": "dotenv -v APP_VARIANT=development -e ../../.env -- expo start",
    "build": "dotenv -e ../../.env -- expo export",
    "build:android": "dotenv -e ../../.env -- expo run:android",
    "build:ios": "dotenv -e ../../.env -- expo run:ios",
    "clean": "rm -rf .expo .turbo dist",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@expo/dom-webview": "~58.0.2",
    "@expo/metro-runtime": "^58.0.17",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/auth": "^26.4.0",
    "@react-native-firebase/database": "^26.4.0",
    "@react-native-firebase/messaging": "^26.4.0",
    "@viclip/constants": "workspace:*",
    "@viclip/types": "workspace:*",
    "@viclip/utils": "workspace:*",
    "expo": "~58.0.23",
    "expo-blur": "^58.0.5",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.16",
    "expo-notifications": "~58.1.9",
    "expo-observe": "~58.0.19",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-share-intent": "^9.0.0",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.21",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-quick-crypto": "^1.1.7",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-toast-message": "^2.5.2",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@biomejs/biome": "2.5.15",
    "@expo/plist": "^0.7.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "^58.0.24",
    "typescript": "~6.0.3"
  }
