---
---

<!-- Hidden checkbox for menu toggle -->
<input type="checkbox" id="mobile-menu-toggle" class="peer sr-only lg:hidden" aria-hidden="true" />

<!-- Mobile Slide Menu -->
<div
  id="mobile-menu"
  class="bg-paper fixed inset-y-0 right-0 z-40 w-64 translate-x-full transform shadow-lg transition-transform duration-300 peer-checked:translate-x-0 lg:hidden"
>
  <div class="border-dark flex items-center justify-between border-b px-4 py-2">
    <div class="text-lg font-bold">Menu</div>
    {/* eslint-disable-next-line jsx-a11y/label-has-associated-control */}
    <label for="mobile-menu-toggle" class="text-dark cursor-pointer p-2">
      <span class="sr-only">Close menu</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width={2}
          d="M6 18L18 6M6 6l12 12"
        ></path>
      </svg>
    </label>
  </div>
  <nav class="px-4 py-2">
    <ul class="space-y-4">
      <li>
        <a href="/#features" class="text-dark hover:text-coral block font-medium">
          Features
        </a>
      </li>
      <li>
        <a href="/about" class="text-dark hover:text-coral block font-medium">
          About Us
        </a>
      </li>
      <li>
        <a href="/privacy-policy" class="text-dark hover:text-coral block font-medium">
          Privacy Policy
        </a>
      </li>
      <li>
        <a
          href="https://github.com/viclip"
          target="_blank"
          rel="noopener noreferrer"
          class="text-dark hover:text-coral block font-medium"
        >
          GitHub
        </a>
      </li>
      <li>
        <a href="/download" class="text-dark hover:text-coral block font-bold">
          Download
        </a>
      </li>
    </ul>
  </nav>
</div>

<!-- Overlay for Mobile Menu -->
{/* eslint-disable-next-line jsx-a11y/label-has-associated-control */}
<label
  for="mobile-menu-toggle"
  class="pointer-events-none fixed inset-0 z-30 bg-black opacity-0 transition-opacity duration-300 peer-checked:pointer-events-auto peer-checked:opacity-50"
  aria-hidden="true"
></label>
