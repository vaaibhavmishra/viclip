---
import Video from "./Video.astro";

const defaultFeatures = {
  titles: ["Syncing ", "at ", "its best"],
  description:
    "ViClip keeps you in flow as you move between screens. Tools should bridge your machines quietly in the background without adding extra steps to your workday.",
  featureTabs: {
    sync: {
      title: "Copy across devices",
      description:
        "Share text from your phone and find it on your computer. Keep moving between screens without emailing yourself or sending a message.",
      video: "share-demo",
      width: 1620,
      height: 1080,
    },
    edit: {
      title: "Edit before you paste",
      description:
        "Tidy up copied text right in ViClip. Save your changes or discard a draft, then reuse the clip when you need it.",
      video: "edit-demo",
      width: 1620,
      height: 1080,
    },
    actions: {
      title: "Keep useful clips",
      description:
        "Pin your go-to snippets so they're easy to find. Unpin them when you're done, or clear clips you no longer need from the action menu.",
      video: "action-demo",
      width: 1620,
      height: 1080,
    },
    settings: {
      title: "Make it yours",
      description:
        "Set your clipboard shortcut, manage connected devices, and choose when to sync or receive notifications. Your clipboard, on your terms.",
      video: "settings-demo",
      width: 1620,
      height: 1080,
    },
  },
};

interface Props {
  titles?: string[];
}

const { titles } = Astro.props;
const features = defaultFeatures;
const descriptions = Object.values(features.featureTabs).map(
  (tab) => tab.description,
);
---

<section id="features" class="relative flex w-full flex-col py-12 text-start lg:py-36">
  <h2 class="mb-2 text-4xl font-bold sm:text-6xl">
    {(titles || features.titles).map((title, index) =>
      title !== '\n' ? (
        <span class="title-line" data-index={index}>
          {title}
        </span>
      ) : (
        <br class="hidden md:block" />
      )
    )}
  </h2>

  <p class="feature-description-text lg:w-1/2">{features.description}</p>

  <div class="mt-6 flex flex-col gap-6 lg:flex-row lg:justify-between lg:gap-2">
    <div class="flex w-full flex-col lg:w-1/3">
      <!-- Mobile Tabs -->
      <div class="flex gap-2 overflow-x-auto p-1 lg:hidden" role="tablist" aria-label="Explore ViClip features">
        {Object.entries(features.featureTabs).map(([key, tab], i) => (
          <button
            id={`feature-tab-${key}`}
            type="button"
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`feature-panel-${key}`}
            tabindex={i === 0 ? 0 : -1}
            class="feature-tab whitespace-nowrap"
            data-index={i}
            data-feature-key={key}
            data-active={i === 0 ? 'true' : undefined}
          >
            {tab.title}
          </button>
        ))}
      </div>

      <!-- Desktop features list -->
      <div id="features-list" class="hidden lg:flex lg:flex-col lg:gap-3" role="tablist" aria-label="Explore ViClip features" aria-orientation="vertical">
        {Object.entries(features.featureTabs).map(([key, tab], i) => (
          <button
            id={`feature-option-${key}`}
            type="button"
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`feature-panel-${key}`}
            tabindex={i === 0 ? 0 : -1}
            class="feature text-start"
            data-index={i}
            data-feature-key={key}
            data-active={i === 0 ? 'true' : undefined}
          >
            <span class="block text-2xl font-bold">{tab.title}</span>
            <span class="block">{tab.description}</span>
          </button>
        ))}
      </div>

      <!-- Mobile description -->
      <div
        class="feature-description mt-4 lg:hidden"
        data-descriptions={descriptions.join('|||')}
      >{descriptions[0]}</div>
    </div>

    <!-- Video Section -->
    <div class="sticky top-6 h-fit w-full lg:w-3/5">
      <div class="relative w-full">
        <div class="video-stack relative h-full w-full">
          {Object.entries(features.featureTabs).map(([key, tab], i) => (
            <div
              id={`feature-panel-${key}`}
              class="feature-panel"
              data-feature-panel
              role="tabpanel"
              aria-labelledby={`feature-tab-${key}`}
              hidden={i !== 0}
            >
              <Video
                id={`feature-demo-${key}`}
                src={`/media/${tab.video}.mp4`}
                poster={`/media/${tab.video}-poster.webp`}
                width={tab.width}
                height={tab.height}
                label={tab.title}
                active={i === 0}
                class="feature-video"
              />
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { animate, stagger } from 'animejs'

  // Animate Titles
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    animate('.title-line', {
    opacity: [0, 1],
    delay: stagger(200, { start: 200 }),
    duration: 600,
    ease: 'outQuad',
  })

  animate('.feature-description-text', {
    opacity: [0, 1],
    delay: 600,
    duration: 600,
    ease: 'outQuad',
  })

  animate('.feature-tab, .feature', {
    opacity: [0, 1],
    delay: stagger(200, { start: 800 }),
    duration: 500,
    ease: 'outQuad',
  })
  }

  const features = document.querySelectorAll('.feature, .feature-tab') as NodeListOf<HTMLElement>
  const descriptionEl = document.querySelector('.feature-description') as HTMLDivElement | null
  const descriptions = descriptionEl?.dataset.descriptions?.split('|||')
  const panels = document.querySelectorAll<HTMLElement>('[data-feature-panel]')

  function changeToFeature({ target }: { target: HTMLElement }) {
    const targetEl = target?.closest('.feature, .feature-tab') as HTMLElement | null
    if (!targetEl) return

    const index = parseInt(targetEl.dataset.index as string, 10)
    if (isNaN(index)) return

    // Toggle active states
    features.forEach(el => {
      const selected = Number(el.dataset.index) === index
      el.toggleAttribute('data-active', selected)
      if (selected) el.setAttribute('data-active', 'true')
      el.setAttribute('aria-selected', String(selected))
      el.tabIndex = selected ? 0 : -1
    })

    // Update mobile description
    if (descriptionEl && descriptions) {
      descriptionEl.textContent = descriptions[index]
    }

    // Animate videos
    panels.forEach((panel, i) => {
      const selected = i === index
      panel.hidden = !selected
      const player = panel.querySelector<HTMLElement>('[data-demo-player]')
      if (!player) return
      player.dataset.active = String(selected)
      player.dispatchEvent(new Event('demo:active'))
    })
  }

  // Set up event listeners
  features.forEach(f => {
    f.addEventListener('click', () => changeToFeature({ target: f }))
    f.addEventListener('keydown', event => {
      const group = Array.from(f.parentElement?.querySelectorAll<HTMLElement>('[role="tab"]') || [])
      const current = group.indexOf(f)
      let next = current
      if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (current + 1) % group.length
      else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = (current - 1 + group.length) % group.length
      else if (event.key === 'Home') next = 0
      else if (event.key === 'End') next = group.length - 1
      else return
      event.preventDefault()
      group[next].focus()
      changeToFeature({ target: group[next] })
    })
  })
  changeToFeature({ target: features[0] })
</script>
<style>
  @reference '../styles/global.css';

  .feature {
    @apply hover:bg-subtle w-full cursor-pointer rounded-lg p-4 select-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-coral;
    transition: background 0.2s ease-in-out;

    &[data-active='true'] {
      @apply bg-subtle;
    }
  }

  .feature-tab {
    @apply hover:bg-subtle rounded-lg px-4 py-2 text-lg font-medium focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-coral;
    transition: background 0.2s ease-in-out;

    &[data-active='true'] {
      @apply bg-subtle;
    }
  }

  .feature-description {
    @apply px-4 text-sm;
  }

  .video-stack {
    @apply overflow-hidden rounded-3xl bg-black shadow-md;
    aspect-ratio: 3/2;
  }

  .feature-panel {
    position: absolute;
    inset: 0;
  }

  .feature-panel[hidden] {
    display: none;
  }

  .feature-panel :global(.feature-video) {
    height: 100%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .feature-panel:not([hidden]) {
      animation: demoReveal 0.25s ease-out;
    }
  }

  @keyframes demoReveal {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* Don't animate translation on small screens */
  @media (max-width: 1024px) {
    .video-stack {
      @apply rounded-xl;
    }
  }
</style>
