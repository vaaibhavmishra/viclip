---
import Button from "../Button.astro";

interface ReleaseInfo {
  label?: string;
  link: string;
  checksum?: string;
}

interface PlatformReleases {
  all?: ReleaseInfo;
  tarball?: ReleaseInfo;
  x86_64?:
    | {
        tarball?: ReleaseInfo;
      }
    | ReleaseInfo;
  aarch64?: {
    tarball?: ReleaseInfo;
  };
  arm64?: ReleaseInfo;
}

interface Props {
  platform: "mac" | "windows" | "linux" | "android";
  icon: string[];
  description: string;
  releases: PlatformReleases;
  cpu: "x86_64" | "aarch64" | "arm64";
}

const { platform, icon, releases, cpu } = Astro.props;

function isFlatReleaseInfo(obj: unknown): obj is ReleaseInfo {
  return !!obj && typeof obj === "object" && "link" in obj;
}

function getReleaseLink(
  releases: PlatformReleases,
  { os, cpu }: { os: string; cpu?: string },
) {
  if (os === "mac") {
    const release = cpu === "arm64" ? releases.arm64 : releases.x86_64;
    return isFlatReleaseInfo(release) ? release.link : "";
  } else if (os === "android") {
    return releases.all?.link || "";
  } else {
    if (cpu === "x86_64") {
      if (isFlatReleaseInfo(releases.x86_64)) {
        return releases.x86_64.link || "";
      }
      return releases.x86_64?.tarball?.link
        ? releases.x86_64?.tarball?.link
        : "";
    } else if (cpu === "aarch64") {
      return releases.aarch64?.tarball?.link || "";
    } else if (cpu === "arm64") {
      return releases.arm64?.link || "";
    }
  }
}
---

<div
  id={`${platform}-${cpu}-downloads`}
  data-active={false}
  class="platform-section group/platform data-[active='false']:hidden"
  data-cpu={cpu}
  data-platform={platform}
>
  <div class="items-center gap-8 md:flex">
    <div class="mx-auto flex w-full justify-center gap-4">
      <Button
        class="download-button w-fit"
        href={getReleaseLink(releases, { os: platform, cpu })}
        isPrimary
      >
        <Fragment set:html={icon} />
        {`Download for ${platform === 'mac' ? 'macOS' : platform.charAt(0).toUpperCase() + platform.slice(1)}`}
      </Button>
    </div>
  </div>
</div>

<style is:global>
  @reference '../../styles/global.css';

  .download-button .svg-inline--fa {
    @apply size-5;
  }
</style>
