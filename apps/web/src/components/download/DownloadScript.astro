<script>
  import { detectDownloadPlatform } from './detect-platform'

  const platformSections = document.querySelectorAll('.platform-section')

  type UserAgentData = {
    getHighEntropyValues?: (hints: string[]) => Promise<{ architecture?: string }>
  }

  async function detectOS() {
    const userAgent = window.navigator.userAgent
    const userAgentData = (window.navigator as Navigator & { userAgentData?: UserAgentData })
      ?.userAgentData

    if (userAgentData?.getHighEntropyValues) {
      try {
        const { architecture } = await userAgentData.getHighEntropyValues(['architecture'])
        return detectDownloadPlatform(userAgent, architecture)
      } catch {
        // Fall back to user agent parsing
      }
    }

    return detectDownloadPlatform(userAgent)
  }

  async function selectPlatform(platform: string, cpu = 'x86_64') {
    let matched = false
    for (const section of platformSections) {
      if (
        section.getAttribute('data-platform') === platform &&
        section.getAttribute('data-cpu') === cpu
      ) {
        section.setAttribute('data-active', 'true')
        matched = true
      } else {
        section.setAttribute('data-active', 'false')
      }
    }

    // Fallback to first available section for this platform if exact CPU didn't match
    if (!matched) {
      for (const section of platformSections) {
        if (section.getAttribute('data-platform') === platform) {
          section.setAttribute('data-active', 'true')
          break
        }
      }
    }
  }

  async function initializePlatform() {
    try {
      const detectedOS = await detectOS()
      await selectPlatform(detectedOS.os, detectedOS.cpu)
    } catch {
      // Default to mac x86_64 or first section
      if (platformSections[0]) {
        platformSections[0].setAttribute('data-active', 'true')
      }
    }
  }

  initializePlatform()
</script>
