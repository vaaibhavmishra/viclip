---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  isHome?: boolean;
  redirect?: string;
}

const { title, description, ogImage, ogImageAlt, isHome, redirect } = Astro.props;
const defaultDescription =
  "ViClip - Universal, real-time, end-to-end encrypted clipboard synchronization across Windows, macOS, Linux, iOS, and Android.";
const usesDefaultImage = !ogImage;
const socialImage = new URL(
  ogImage || "/og-image.png",
  Astro.site ?? "https://viclip.shipby.me",
).href;
const socialImageAlt =
  ogImageAlt ??
  (usesDefaultImage
    ? "ViClip: One clipboard for all your devices. Real-time sync with end-to-end encryption."
    : `${title} preview`);

import "@fontsource/bricolage-grotesque/400.css";
import "@fontsource/bricolage-grotesque/500.css";
import "@fontsource/bricolage-grotesque/600.css";
import "@fontsource/bricolage-grotesque/800.css";
import "../styles/global.css";
import Footer from "~/components/Footer.astro";
import NavBar from "~/components/NavBar.astro";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline data-cfasync="false">
      (() => {
        let preference = 'system'
        try {
          const savedTheme = localStorage.getItem('theme')
          if (savedTheme === 'light' || savedTheme === 'dark' || savedTheme === 'system') {
            preference = savedTheme
          }
        } catch {
          // Follow the system theme when browser storage is unavailable.
        }

        const theme = preference === 'system'
          ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
          : preference
        const html = document.documentElement
        html.setAttribute('data-theme-preference', preference)
        html.setAttribute('data-theme', theme)
        html.classList.toggle('dark', theme === 'dark')
        html.style.colorScheme = theme
      })()
    </script>
    {redirect ? <meta http-equiv="refresh" content={`0;url=${redirect}`} /> : null}
    <meta name="description" content={description ?? defaultDescription} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-0.xml" />

    {isHome && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify({
          '@context': 'https://schema.org',
          '@type': 'WebSite',
          name: 'ViClip',
          url: 'https://viclip.shipby.me/',
        })}
      ></script>
    )}

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="theme-color" content="#2563eb" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={socialImageAlt} />
    {usesDefaultImage && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:type" content="image/png" />
      </>
    )}
    <meta property="og:description" content={description ?? defaultDescription} />
    <meta property="og:color" content="#2563eb" />
    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description ?? defaultDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <meta name="google-site-verification" content="x571Zb7_L3qvN7DgtYKMyYBg1eFWpdzyUHDgdhsFEZU" />
  </head>
  <body class="bg-paper text-dark min-h-[max(100dvh,_64rem)] overflow-x-hidden font-['bricolage-grotesque'] text-balance">
    <NavBar />
    <slot />
    <Footer />
  </body>
</html>
