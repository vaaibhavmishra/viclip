---
import { icon, library } from "@fortawesome/fontawesome-svg-core";
import {
  faAndroid,
  faApple,
  faGithub,
  faLinux,
  faWindows,
} from "@fortawesome/free-brands-svg-icons";
import { Image } from "astro:assets";
import iconBlack from "~/assets/icon-black-cropped.png";
import iconWhite from "~/assets/icon-white-cropped.png";
import Description from "~/components/Description.astro";
import ButtonCard from "~/components/download/ButtonCard.astro";
import DownloadScript from "~/components/download/DownloadScript.astro";
import PlatformDownload from "~/components/download/PlatformDownload.astro";
import { getReleases } from "~/components/download/release-data";
import Layout from "~/layouts/Layout.astro";

library.add(faWindows, faLinux, faApple, faGithub, faAndroid);
const windowsIcon = icon({ prefix: "fab", iconName: "windows" });
const linuxIcon = icon({ prefix: "fab", iconName: "linux" });
const appleIcon = icon({ prefix: "fab", iconName: "apple" });

const releases = getReleases();

const platformDescriptions = {
  mac: "Experience seamless clipboard sync on macOS with universal Apple Silicon and Intel support.",
  windows: "Fast, real-time clipboard sync for Windows 10 and 11 (x64 and ARM64).",
  linux: "Available as an AppImage and Flatpak for all major Linux distributions.",
};

const download = {
  title: "Download ViClip",
  description:
    "Universal, real-time, end-to-end encrypted clipboard synchronization across Windows, macOS, Linux, iOS, and Android.",
  beta: "ViClip Desktop is currently in ",
  otherDownload:
    "Looking for other architectures or source code? Check our <a href='https://github.com/ViClip-Org/ViClip-Desktop/releases/latest' target='_blank' rel='noopener noreferrer' class='underline text-coral font-medium'>GitHub Releases</a>.",
};
---

<DownloadScript />

<Layout
  title="Download ViClip - Universal Clipboard Sync"
  description="Download ViClip for macOS, Windows, and Linux. End-to-end encrypted real-time clipboard synchronization across all your devices."
>
  <main class="container mx-auto px-6 pt-28 pb-36">
    <div class="relative mx-auto max-w-4xl">
      <!-- Header / Logo -->
      <div class="mb-10 flex flex-col items-center gap-4 text-center">
        <div class="download-browser-logo mb-2 flex justify-center">
          <Image
            src={iconBlack}
            alt="ViClip Logo"
            width={80}
            height={80}
            class="size-20 object-contain dark:hidden"
          />
          <Image
            src={iconWhite}
            alt="ViClip Logo"
            width={80}
            height={80}
            class="hidden size-20 object-contain dark:block"
          />
        </div>
        <Description id="download-title" class="text-4xl sm:text-6xl font-bold tracking-tight text-dark">
          {download.title}
        </Description>
        <Description class="max-w-2xl text-base sm:text-lg text-dark/70">
          {download.description}
        </Description>
      </div>

      <!-- Auto-Detected Platform Download Section -->
      <div class="my-8 flex justify-center">
        <!-- MacOS Download -->
        <PlatformDownload
          platform="mac"
          icon={appleIcon.html}
          description={platformDescriptions.mac}
          releases={releases.macos}
          cpu="x86_64"
        />

        <PlatformDownload
          platform="mac"
          icon={appleIcon.html}
          description={platformDescriptions.mac}
          releases={releases.macos}
          cpu="arm64"
        />

        <!-- Windows Download -->
        <PlatformDownload
          platform="windows"
          icon={windowsIcon.html}
          description={platformDescriptions.windows}
          releases={releases.windows}
          cpu="x86_64"
        />

        <PlatformDownload
          platform="windows"
          icon={windowsIcon.html}
          description={platformDescriptions.windows}
          releases={releases.windows}
          cpu="arm64"
        />

        <!-- Linux Download -->
        <PlatformDownload
          platform="linux"
          icon={linuxIcon.html}
          description={platformDescriptions.linux}
          releases={releases.linux}
          cpu="x86_64"
        />

        <PlatformDownload
          platform="linux"
          icon={linuxIcon.html}
          description={platformDescriptions.linux}
          releases={releases.linux}
          cpu="aarch64"
        />
      </div>

      <!-- Beta Tag & Other Downloads notice -->
      <div class="mb-16 flex flex-col items-center justify-center gap-2 text-center">
        <div class="flex cursor-default items-center justify-center gap-2 text-xs sm:text-sm font-semibold text-dark/80">
          <span>{download.beta}</span>
          <span class="inline-flex items-center rounded-md border border-dark/20 bg-dark/5 px-2 py-0.5 text-xs font-bold uppercase tracking-wider text-dark">
            Beta
          </span>
        </div>
        <div class="max-w-lg text-xs sm:text-sm text-dark/60">
          <Fragment set:html={download.otherDownload} />
        </div>
      </div>

      <!-- All Platforms Grid -->
      <div class="mt-12 border-t border-dark/10 pt-12">
        <h2 class="mb-6 text-center text-2xl font-bold tracking-tight text-dark sm:text-3xl">
          All Available Downloads
        </h2>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <!-- macOS -->
          <ButtonCard
            label="macOS Universal (.dmg)"
            href={releases.macos.universal.link}
            variant="mac"
          />

          <!-- Windows 64-bit -->
          <ButtonCard
            label="Windows 64-bit (.exe)"
            href={releases.windows.x86_64.link}
            variant="windows"
          />

          <!-- Windows ARM64 -->
          <ButtonCard
            label="Windows ARM64 (.exe)"
            href={releases.windows.arm64.link}
            variant="windows"
          />

          <!-- Linux AppImage x86_64 -->
          <ButtonCard
            label="Linux AppImage (x86_64)"
            href={releases.linux.x86_64.tarball.link}
            variant="linux"
          />

          <!-- Linux AppImage ARM64 -->
          <ButtonCard
            label="Linux AppImage (ARM64)"
            href={releases.linux.aarch64.tarball.link}
            variant="linux"
          />

          <!-- Linux Flathub -->
          <ButtonCard
            label="Linux Flatpak (Flathub)"
            href={releases.linux.flathub.all.link}
            variant="linux"
          />
        </div>
      </div>
    </div>
  </main>
</Layout>

<style is:global>
  @reference '../styles/global.css';

  .download-card__icon {
    @apply bg-subtle text-coral flex h-10 w-10 items-center justify-center rounded-full p-2;
  }

  .download-card__icon svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .os-icon svg {
    height: 3rem;
    width: 3rem;
  }
</style>
