{
  "name": "@viclip/desktop",
  "license": "GPL-3.0-or-later",
  "main": "./out/main/index.js",
  "scripts": {
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "start": "dotenv -e ../../.env -- electron-vite preview",
    "dev": "dotenv -e ../../.env -- electron-vite dev",
    "build": "pnpm run typecheck && dotenv -e ../../.env -- electron-vite build",
    "postinstall": "install-electron &&electron-builder install-app-deps",
    "build:unpack": "pnpm run build && electron-builder --dir --config",
    "build:win": "pnpm run build && electron-builder --win --config",
    "build:mac": "pnpm run build && electron-builder --mac --config",
    "build:linux": "pnpm run build && electron-builder --linux --config",
    "clean": "rm -rf out .turbo node_modules"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "colors": "^1.4.0",
    "electron-conf": "^1.3.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.2.1",
    "firebase": "^12.19.0",
    "google-auth-library": "^11.1.0",
    "lucide-react": "^1.51.0",
    "radix-ui": "^1.6.7",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.2",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@viclip/constants": "workspace:*",
    "@viclip/types": "workspace:*",
    "@viclip/utils": "workspace:*",
    "@vitejs/plugin-react": "^5.2.0",
    "dmg-builder": "26.15.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
