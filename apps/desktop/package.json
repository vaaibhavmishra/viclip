{
  "name": "@viclip/desktop",
  "version": "2.0.0",
  "license": "GPL-3.0-or-later",
  "main": "./out/main/index.js",
  "scripts": {
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "start": "dotenv -e ../../.env -- electron-vite preview",
    "dev": "dotenv -e ../../.env -- electron-vite dev",
    "build": "pnpm run typecheck && dotenv -e ../../.env -- electron-vite build",
    "postinstall": "install-electron &&electron-builder install-app-deps",
    "build:unpack": "pnpm run build && electron-builder --dir --config electron-builder.yml",
    "build:win": "pnpm run build && electron-builder --win --config electron-builder.yml",
    "build:mac": "pnpm run build && electron-builder --mac --config electron-builder.yml",
    "build:linux": "pnpm run build && electron-builder --linux --config electron-builder.yml",
    "clean": "rm -rf out .turbo node_modules"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-conf": "^1.3.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^13.2.0",
    "lucide-react": "^1.68.0",
    "radix-ui": "^1.8.1",
    "react-router": "^8.5.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.3",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@viclip/constants": "workspace:*",
    "@viclip/types": "workspace:*",
    "@viclip/utils": "workspace:*",
    "@vitejs/plugin-react": "^6.2.1",
    "dmg-builder": "26.18.0",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "electron-builder-squirrel-windows": "26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
